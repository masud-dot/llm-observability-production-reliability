# Copy to deploy/compose/.env to override the Compose defaults.
# The stack runs without this file; never commit a real key.

# HMAC key for the Collector's pseudonymising redaction (32+ bytes).
# Empty means the development-only default in docker-compose.yml.
REDACTION_HMAC_KEY=

# Where Grafana's contact point sends alerts.
WRENHOLT_INCIDENT_WEBHOOK=http://incidents:8300/alerts
