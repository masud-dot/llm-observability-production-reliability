{
  "uid": "wrenholt-telemetry-pipeline",
  "title": "Telemetry pipeline",
  "tags": [
    "wrenholt",
    "chapter-10"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Spans accepted and refused by the receiver",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "accepted",
          "expr": "sum(rate(otelcol_receiver_accepted_spans[5m]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "refused",
          "expr": "sum(rate(otelcol_receiver_refused_spans[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Export queue fill by exporter",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{exporter}}",
          "expr": "max by (exporter) (otelcol_exporter_queue_size / otelcol_exporter_queue_capacity)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dropped at a full queue (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "spans",
          "expr": "sum(increase(otelcol_exporter_enqueue_failed_spans[1h]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "metric points",
          "expr": "sum(increase(otelcol_exporter_enqueue_failed_metric_points[1h]))"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "log records",
          "expr": "sum(increase(otelcol_exporter_enqueue_failed_log_records[1h]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failed sends by exporter",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{exporter}}",
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans[5m]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{exporter}}",
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_metric_points[5m]))"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{exporter}}",
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_log_records[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Traces kept, by policy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{policy}}",
          "expr": "sum by (policy) (rate(otelcol_processor_tail_sampling_count_traces_sampled{sampled=\"true\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Share of traces kept",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled{sampled=\"true\"}[5m])) / sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Traces dropped before a decision (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 14,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(otelcol_processor_tail_sampling_sampling_trace_dropped_too_early[1h]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Collector memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "resident",
          "expr": "max(otelcol_process_memory_rss)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Go heap",
          "expr": "max(otelcol_process_runtime_heap_alloc_bytes)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Sampling decision time p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(otelcol_processor_tail_sampling_sampling_decision_timer_latency_bucket[5m])))"
        }
      ]
    }
  ]
}
