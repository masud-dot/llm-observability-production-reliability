{
  "uid": "wrenholt-slo",
  "title": "SLOs and error budgets",
  "tags": [
    "wrenholt",
    "chapter-12"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Error budget left over 28 days, by SLO",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{slo}}",
          "expr": "slo:error_budget_remaining:ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -1,
          "max": 1
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Burn rate over the last hour, by SLO",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{slo}}",
          "expr": "slo:sli_error:ratio_rate1h / on (slo, sli, layer) (1 - slo:objective:ratio)"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "SLI over 28 days against its objective",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{slo}} SLI",
          "expr": "1 - slo:sli_error:ratio_rate28d and on (slo) slo:objective:ratio"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{slo}} objective",
          "expr": "slo:objective:ratio"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Valid events in the last hour, by SLO",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{slo}}",
          "expr": "slo:valid_events:increase1h"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Resolution and provider attempts (no objective)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{slo}}",
          "expr": "1 - slo:sli_error:ratio_rate1h{slo=~\"resolution|provider_attempts\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cost per resolved conversation (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "USD",
          "expr": "sum(increase(wrenholt_gateway_cost_total[1h])) / sum(increase(wrenholt_slo_events_total{wrenholt_slo_sli=\"resolution\",wrenholt_slo_good=\"true\"}[1h]))"
        }
      ]
    }
  ]
}
